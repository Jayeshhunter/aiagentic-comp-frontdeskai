# =============================================================
#  FrontDesk AI — Environment Variables
# =============================================================
#  The app does nothing without an LLM. It talks to one OpenAI-compatible
#  LiteLLM gateway: set LITELLM_BASE_URL and LITELLM_API_KEY below.
#
#  In the workshop sandbox you do NOT need this file for the LLM: your
#  JupyterLab terminal already exports LITELLM_BASE_URL, LITELLM_API_KEY and
#  LITELLM_MODEL, and scripts/deploy-spark.sh wires your own key into the app.
#
#  Elsewhere (Codespace, local kind, python app/app.py):
#      cp .env.example .env      # fill in the LiteLLM block
#      bash scripts/quickstart.sh
# =============================================================

# -----------------------------------------------------------
# LLM — LiteLLM gateway (required)
# LITELLM_BASE_URL ends in /v1. The gateway must be reachable from where the
# app runs: the sandbox gateway (litellm-gateway.llm-serving.svc...) is
# cluster-internal and cannot be reached from a Codespace or a laptop.
# Left empty here, the scripts use the same variables from your environment.
# -----------------------------------------------------------
LLM_PROVIDER=litellm
LITELLM_BASE_URL=
LITELLM_API_KEY=
LLM_MODEL=qwen36-35b-a3b-lab
# No second gateway to fall back to. An empty model disables the fallback.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# -----------------------------------------------------------
# App settings
# -----------------------------------------------------------
# Shared password for each user's first login (then hashed per user)
AUTH_PASSWORD=brainupgrade

# Comma-separated admin emails — required for the skill_admin scenarios
ADMIN_EMAILS=admin@unigps.in

# Pre-populate 10 employees, leave balances, tickets, expenses, rooms and
# payslips on startup. The Kubernetes path already sets this in
# scripts/manifests/deployment.yaml; keep it here so a direct
# `python app/app.py` run gets the same demo data. The seed is idempotent.
SEED_DEMO_DATA=true

# -----------------------------------------------------------
# LangFuse — LLM prompt/completion/cost tracing (optional)
# All three must be set or tracing stays disabled. The host is region-specific,
# and each region has its own UI and its own keys:
#   https://us.cloud.langfuse.com   (US)
#   https://cloud.langfuse.com      (EU)
#   https://jp.cloud.langfuse.com   (JP)
# A key pair belongs to ONE region: an EU pair returns 401 against the US host.
#
# Keys reach the cluster through a K8s secret. In the workshop sandbox the three
# LANGFUSE_ values are already in your terminal environment and
# scripts/deploy-spark.sh uses them when this file leaves them empty. A value set
# here wins. (On kind/local, rerun scripts/deploy.sh or scripts/update-secret.sh.)
#
# LANGFUSE_HOST is the name the app reads. deploy-spark.sh also accepts
# LANGFUSE_BASE_URL, which is what the Langfuse SDK docs call it.
# -----------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# -----------------------------------------------------------
# OpenTelemetry — keep this as 'frontdeskai': the Grafana dashboards, PromQL
# examples and Tempo queries in observability.md all filter on this name.
# -----------------------------------------------------------
OTEL_SERVICE_NAME=frontdeskai
